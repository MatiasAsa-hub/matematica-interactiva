---
// Sección para tutores: "Cómo usar esta página en una clase" + notas por tema,
// todo en carpetas desplegables.
import Base from '../../layouts/Base.astro';
import ArbolDeTemas from '../../components/ArbolDeTemas.astro';
import { listaDeTemas, obtenerTema, obtenerPagina } from '../../lib/contenido.js';

const pagina = obtenerPagina('como-usar');
const conNotas = listaDeTemas().filter((t) => obtenerTema(t.slug).tieneTutores);
---
<Base titulo="Para tutores" seccion="tutores">
  <div class="contenedor">
    <p class="sobretitulo">Para tutores</p>
    <h1>Notas para preparar la clase</h1>
    <p class="texto-suave">Abrí una carpeta para ver los temas. Cada tema tiene sus notas y el mismo interactivo que ven los alumnos.</p>

    <details class="carpeta carpeta-guia">
      <summary><span class="carpeta-titulo">{pagina.datos.titulo}</span></summary>
      <div class="desplegado texto" set:html={pagina.html} />
    </details>

    <ArbolDeTemas temas={conNotas} destino="tutores" />
  </div>
</Base>
