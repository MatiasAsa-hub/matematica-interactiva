---
// Sección para tutores: la guía "Cómo usar esta página en una clase" y las
// notas de cada tema, agrupadas por unidad igual que la lista de temas.
import Base from '../../layouts/Base.astro';
import ArbolDeTemas from '../../components/ArbolDeTemas.astro';
import { obtenerTema, obtenerPagina } from '../../lib/contenido.js';

const pagina = obtenerPagina('como-usar');
const conNotas = (t) => obtenerTema(t.slug).tieneTutores;
---
<Base titulo="Para tutores" seccion="tutores">
  <div class="contenedor">
    <header class="pagina-cabecera">
      <p class="sello-tutores">Para tutores</p>
      <h1>Preparar la clase</h1>
      <p class="bajada">Cada tema tiene sus notas: qué tiene que llevarse el alumno, los errores típicos, qué dibujar en el pizarrón y qué preguntar.</p>
    </header>

    <details class="guia-clase">
      <summary>{pagina.datos.titulo}</summary>
      <div class="desplegado texto" set:html={pagina.html} />
    </details>

    <ArbolDeTemas destino="tutores" filtro={conNotas} />
  </div>
</Base>
