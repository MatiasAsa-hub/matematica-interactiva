---
// Notas para tutores de un tema. El interactivo es el mismo que ven los alumnos.
// En la compu: las notas a la izquierda y el interactivo fijo a la derecha.
import Base from '../../layouts/Base.astro';
import Interactivo from '../../components/Interactivo.astro';
import Volver from '../../components/Volver.astro';
import AnteriorSiguiente from '../../components/AnteriorSiguiente.astro';
import BotonGuia from '../../components/BotonGuia.astro';
import { tieneGuia } from '../../lib/guia.js';
import { listaDeTemas, obtenerTema, unidadDe, vecinosDe } from '../../lib/contenido.js';
import { url } from '../../lib/rutas.js';

const conNotas = (t) => obtenerTema(t.slug).tieneTutores;

export function getStaticPaths() {
  return listaDeTemas()
    .filter((t) => obtenerTema(t.slug).tieneTutores)
    .map((t) => ({ params: { tema: t.slug } }));
}

const tema = obtenerTema(Astro.params.tema);
const unidad = unidadDe(tema.slug);
const { anterior, siguiente } = vecinosDe(tema.slug, conNotas);
const notas = tema.partes.find((p) => p.tipo === 'tutores');
---
<Base titulo={`Tutores: ${tema.titulo}`} seccion="tutores">
  <div class="contenedor">
    <header class="tema-cabecera">
      <Volver href={url(`tutores/#${unidad?.id ?? ''}`)} texto={`Tutores · ${unidad?.nombre ?? ''}`} />
      <p class="sello-tutores">Notas para tutores</p>
      <h1>{tema.titulo}</h1>
      <p class="bajada">Para preparar la clase. <a href={url(`temas/${tema.slug}/`)}>Ver el tema como lo ve el alumno</a>.</p>
      {tieneGuia(tema) && <p class="acciones-tema"><BotonGuia ruta={`guia/${tema.slug}/`} texto="Imprimir la guía del alumno" /></p>}
    </header>

    <div class:list={['tema-cuerpo', { 'con-interactivo': Boolean(tema.interactivo) }]} style="--filas: 1">
      <section class="parte notas-tutor texto" set:html={notas?.html} />

      {tema.interactivo && (
        <aside class="tema-interactivo" aria-label="Interactivo">
          <div class="tema-interactivo-fijo marco-interactivo">
            <h2 class="rotulo titulo-interactivo-tutores">El interactivo · el mismo que ven los alumnos</h2>
            <Interactivo nombre={tema.interactivo} opciones={tema.opciones} />
            {tema.opciones.interactivo2 && (
              <div class="interactivo-segundo">
                <Interactivo nombre={tema.opciones.interactivo2} opciones={tema.opciones} />
              </div>
            )}
          </div>
        </aside>
      )}
    </div>

    <div class="cierre-tema">
      <AnteriorSiguiente anterior={anterior} siguiente={siguiente} destino="tutores" unidadActual={unidad?.id ?? ''} />
    </div>
  </div>
</Base>
