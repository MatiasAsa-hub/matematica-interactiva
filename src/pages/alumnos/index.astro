---
// Lista de temas: las unidades agrupadas por etapa. Cada unidad se abre con un toque.
import Base from '../../layouts/Base.astro';
import ArbolDeTemas from '../../components/ArbolDeTemas.astro';
import { obtenerPagina } from '../../lib/contenido.js';

const pagina = obtenerPagina('alumnos');
---
<Base titulo="Temas" seccion="alumnos">
  <div class="contenedor">
    <header class="pagina-cabecera">
      <h1>{pagina.datos.titulo}</h1>
      <div class="bajada" set:html={pagina.html} />
    </header>
    <ArbolDeTemas destino="temas" />
  </div>
</Base>
