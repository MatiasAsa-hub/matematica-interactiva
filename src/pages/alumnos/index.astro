---
// Lista de temas, en carpetas desplegables por sección y subsección.
import Base from '../../layouts/Base.astro';
import ArbolDeTemas from '../../components/ArbolDeTemas.astro';
import { listaDeTemas, obtenerPagina } from '../../lib/contenido.js';

const pagina = obtenerPagina('alumnos');
---
<Base titulo="Temas" seccion="alumnos">
  <div class="contenedor">
    <h1 style="margin-top:1.4rem">{pagina.datos.titulo}</h1>
    <div class="texto" set:html={pagina.html} />
    <ArbolDeTemas temas={listaDeTemas()} destino="temas" />
  </div>
</Base>
