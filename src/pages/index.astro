---
// Página de inicio: presentación, los dos caminos (alumno o tutor),
// el recorrido de unidades (una tarjeta por unidad), cómo es cada tema y
// los accesos al resto.
// Los textos están en contenido/paginas/inicio.md y contenido/sitio.md.
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import IconoUnidad from '../components/IconoUnidad.astro';
import { datosDelSitio, obtenerPagina, obtenerTema, listaDeUnidades } from '../lib/contenido.js';
import { url } from '../lib/rutas.js';

const sitio = datosDelSitio();
const t = obtenerPagina('inicio').datos;
const unidades = listaDeUnidades();
const temas = unidades.flatMap((u) => u.temas);

// Los números grandes de la portada: se cuentan solos.
const ejercicios = temas
  .flatMap((x) => obtenerTema(x.slug).partes)
  .filter((p: any) => p.tipo === 'ejercicios')
  .flatMap((p: any) => p.ejercicios)
  .filter((e: any) => e.tipo !== 'nivel').length;
const cifras = [
  { numero: unidades.length, nombre: 'unidades' },
  { numero: temas.length, nombre: 'temas' },
  { numero: ejercicios, nombre: 'ejercicios' },
];

const accesos = [
  { href: url('interactivos/'), ...t.accesos.interactivos, icono: 'M3 20c3-9 6-13 9-8s6 1 9-8M3 4v16h18' },
  { href: url('laboratorio/'), ...t.accesos.laboratorio, icono: 'M9 3h6M10 3v6l-5 9a2 2 0 0 0 2 3h10a2 2 0 0 0 2-3l-5-9V3M7.5 15h9' },
  { href: url('notacion/'), ...t.accesos.notacion, icono: 'M5 4h14M9 4v16M15 4c0 6 0 11 3 16M5 20h7' },
  { href: url('tutores/'), ...t.accesos.tutores, icono: 'M3 5h18v11H3zM8 20h8M12 16v4M7 9h6M7 12h9' },
];
---
<Base seccion="inicio">
  <div class="contenedor">
    <section class="portada">
      <div>
        <Logo medida={54} />
        <h1>{sitio.nombre}</h1>
        <p class="bajada">{sitio.descripcion}</p>
        <div class="portada-botones">
          <a class="boton boton-principal boton-grande" href={url('alumnos/')}>{t.botones.alumnos}</a>
          <a class="boton boton-grande" href={url('tutores/')}>{t.botones.tutores}</a>
        </div>
      </div>
      <ul class="cifras" aria-label="Qué hay en la página">
        {cifras.map((c) => (
          <li class="cifra">
            <span class="cifra-numero">{c.numero}</span>
            <span class="cifra-nombre">{c.nombre}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="bloque-inicio">
      <h2>{t.recorrido.titulo}</h2>
      <p class="texto-suave">{t.recorrido.texto}</p>
      <div class="recorrido">
        {sitio.etapas.map((etapa: any) => (
          <div class="recorrido-etapa">
            <p class="etapa-titulo">{etapa.nombre}</p>
            <div class="grilla-tarjetas grilla-3">
              {unidades.filter((u) => u.etapa === etapa.id).map((u) => (
                <a class="tarjeta-link tarjeta-unidad" href={url(`alumnos/#${u.id}`)}>
                  <IconoUnidad id={u.id} />
                  <span class="tarjeta-unidad-textos">
                    <span class="tarjeta-numero">Unidad {u.numero}</span>
                    <span class="tarjeta-titulo">{u.nombre}</span>
                    <span class="tarjeta-texto">{u.descripcion}</span>
                    <span class="tarjeta-pie">{u.temas.length} temas</span>
                  </span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="bloque-inicio">
      <h2>{t.pasos.titulo}</h2>
      <ol class="pasos-tema">
        {t.pasos.lista.map((p: any, i: number) => (
          <li>
            <span class="paso-grande" aria-hidden="true">{i + 1}</span>
            <strong>{p.titulo}</strong>
            <span class="texto-suave">{p.texto}</span>
          </li>
        ))}
      </ol>
    </section>

    <section class="bloque-inicio">
      <h2>{t.accesos.titulo}</h2>
      <nav class="grilla-tarjetas" aria-label="Otras secciones" style="margin-top: 1.1rem">
        {accesos.map((a) => (
          <a class="tarjeta-link acceso" href={a.href}>
            <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
              <path d={a.icono} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span class="acceso-textos">
              <span class="tarjeta-titulo">{a.titulo}</span>
              <span class="tarjeta-texto">{a.texto}</span>
            </span>
          </a>
        ))}
      </nav>
    </section>
  </div>
</Base>
