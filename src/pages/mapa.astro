---
// Mapa de correlativas: todos los temas, agrupados por unidad como un plan de
// estudios, con flechas de requisito (campo "necesita:" de cada tema).
// Al tocar un tema se marca todo su camino hacia atrás y el resto se apaga.
// Se mueve y se acerca como los gráficos: con dos dedos en el celular y
// arrastrando con el mouse en la compu (Ctrl + rueda para acercar).
// El texto de arriba está en contenido/paginas/mapa.md.
import Base from '../layouts/Base.astro';
import { datosDelSitio, listaDeUnidades, obtenerPagina } from '../lib/contenido.js';
import { armarMapa, renglones, MEDIDAS } from '../lib/mapa.js';
import { url } from '../lib/rutas.js';

const pagina = obtenerPagina('mapa');
const mapa = armarMapa(listaDeUnidades(), datosDelSitio().etapas);
const M = MEDIDAS;
// lo que necesita el navegador para marcar caminos y armar el cartelito
const datos = mapa.nodos.map((n) => ({ s: n.slug, t: n.titulo, n: n.necesita, h: url(`temas/${n.slug}/`) }));
---
<Base titulo={pagina.datos.titulo} seccion="mapa">
  <div class="contenedor">
    <header class="pagina-cabecera">
      <h1>{pagina.datos.titulo}</h1>
      <div class="bajada" set:html={pagina.html} />
    </header>

    <div class="mapa-marco" data-mapa>
      <svg class="mapa-svg" data-svg role="group" aria-label="Mapa de temas con sus correlativas">
        <defs>
          <marker id="punta" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M0,1 L9,5 L0,9 z" class="mapa-punta" />
          </marker>
          <marker id="punta-camino" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M0,1 L9,5 L0,9 z" class="mapa-punta-camino" />
          </marker>
        </defs>
        <g data-mundo>
          <rect class="mapa-fondo" data-fondo x="0" y="0" width={mapa.ancho} height={mapa.alto} />

          {mapa.grupos.map((g) => (
            <g class="mapa-etapa">
              <line x1={g.x} x2={g.x + g.ancho} y1={M.margen + 4} y2={M.margen + 4} />
              <text x={g.x} y={M.margen - 4}>{g.nombre.toUpperCase()}</text>
            </g>
          ))}
          {mapa.columnas.map((c) => (
            <g class="mapa-unidad">
              <text x={c.x} y={M.margen + 30} class="mapa-unidad-numero">UNIDAD {c.numero}</text>
              {renglones(c.nombre, 19).slice(0, 2).map((r, i) => (
                <text x={c.x} y={M.margen + 50 + i * 18} class="mapa-unidad-nombre">{r}</text>
              ))}
            </g>
          ))}

          <g class="mapa-flechas">
            {mapa.flechas.map((f) => (
              <path d={f.d} data-desde={f.desde} data-hasta={f.hasta} marker-end="url(#punta)" />
            ))}
          </g>

          <g class="mapa-nodos">
            {mapa.nodos.map((n) => {
              const lineas = renglones(n.titulo).slice(0, 3);
              const y0 = n.y + M.alto / 2 - ((lineas.length - 1) * 15) / 2;
              return (
                <a href={url(`temas/${n.slug}/`)} class="mapa-nodo" data-slug={n.slug} aria-label={n.titulo}>
                  <rect x={n.x} y={n.y} width={M.ancho} height={M.alto} rx="11" />
                  {lineas.map((l, i) => (
                    <text x={n.x + 12} y={y0 + i * 15} dominant-baseline="middle">{l}</text>
                  ))}
                </a>
              );
            })}
          </g>
        </g>
      </svg>

      <div class="plano-botones mapa-botones">
        <button type="button" class="plano-boton" data-zoom="1.25" aria-label="Acercar" title="Acercar">+</button>
        <button type="button" class="plano-boton" data-zoom="0.8" aria-label="Alejar" title="Alejar">−</button>
        <button type="button" class="plano-boton" data-inicio aria-label="Volver a la vista inicial" title="Volver a la vista inicial">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.4-5.7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/><path d="M4 4v4.5h4.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
      <div class="plano-aviso" data-aviso aria-hidden="true"></div>
    </div>
    <p class="mapa-ayuda texto-suave">
      <span class="solo-celular">Con dos dedos movés el mapa y lo acercás.</span>{" "}
      <span class="solo-compu">Arrastrá para moverlo; Ctrl + rueda (o los botones) para acercar.</span>{" "}
      Tocá un tema para ver su camino; tocalo de nuevo para abrirlo.
    </p>

    <section class="mapa-info tarjeta" data-info aria-live="polite" hidden></section>
  </div>

  <script type="application/json" id="datos-mapa" set:html={JSON.stringify(datos)} />
</Base>

<script>
  // ------------------------------------------------------------------
  // Datos: cada tema con lo que necesita (directo).
  // ------------------------------------------------------------------
  type Tema = { s: string; t: string; n: string[]; h: string };
  const temas: Tema[] = JSON.parse(document.getElementById('datos-mapa')!.textContent!);
  const porSlug = new Map(temas.map((t) => [t.s, t]));
  const orden = new Map(temas.map((t, i) => [t.s, i]));

  /** Todos los temas que hay que saber antes (directos e indirectos). */
  function haciaAtras(slug: string) {
    const vistos = new Set<string>();
    const pila = [...(porSlug.get(slug)?.n ?? [])];
    while (pila.length) {
      const s = pila.pop()!;
      if (vistos.has(s)) continue;
      vistos.add(s);
      pila.push(...(porSlug.get(s)?.n ?? []));
    }
    return vistos;
  }

  const marco = document.querySelector<HTMLElement>('[data-mapa]')!;
  const svg = marco.querySelector<SVGSVGElement>('[data-svg]')!;
  const mundo = svg.querySelector<SVGGElement>('[data-mundo]')!;
  const fondo = svg.querySelector<SVGRectElement>('[data-fondo]')!;
  const info = document.querySelector<HTMLElement>('[data-info]')!;
  const aviso = marco.querySelector<HTMLElement>('[data-aviso]')!;
  const nodos = [...svg.querySelectorAll<SVGAElement>('.mapa-nodo')];
  const flechas = [...svg.querySelectorAll<SVGPathElement>('.mapa-flechas path')];
  const ANCHO = Number(fondo.getAttribute('width'));
  const ALTO = Number(fondo.getAttribute('height'));

  // ------------------------------------------------------------------
  // Elegir un tema: se marca su camino hacia atrás y el resto se apaga.
  // ------------------------------------------------------------------
  let elegido: string | null = null;

  function elegir(slug: string | null) {
    elegido = slug;
    svg.classList.toggle('hay-eleccion', !!slug);
    if (!slug) {
      nodos.forEach((n) => n.classList.remove('en-camino', 'elegido'));
      flechas.forEach((f) => { f.classList.remove('en-camino'); f.setAttribute('marker-end', 'url(#punta)'); });
      info.hidden = true;
      return;
    }
    const atras = haciaAtras(slug);
    const camino = new Set([...atras, slug]);
    nodos.forEach((n) => {
      const s = n.dataset.slug!;
      n.classList.toggle('en-camino', camino.has(s));
      n.classList.toggle('elegido', s === slug);
    });
    flechas.forEach((f) => {
      const si = camino.has(f.dataset.hasta!) && camino.has(f.dataset.desde!);
      f.classList.toggle('en-camino', si);
      f.setAttribute('marker-end', si ? 'url(#punta-camino)' : 'url(#punta)');
      // las flechas marcadas van arriba de las otras
      if (si) f.parentNode!.appendChild(f);
    });
    const t = porSlug.get(slug)!;
    const lista = [...atras].sort((a, b) => orden.get(a)! - orden.get(b)!);
    const link = (s: string) => `<a class="mapa-chip" href="${porSlug.get(s)!.h}">${porSlug.get(s)!.t}</a>`;
    info.innerHTML = `
      <div class="mapa-info-cabeza">
        <h2>${t.t}</h2>
        <a class="boton boton-principal boton-chico" href="${t.h}">Ir al tema →</a>
      </div>
      ${lista.length === 0
        ? '<p class="texto-suave">No necesita ningún tema de la página: se puede arrancar por acá.</p>'
        : `<p class="texto-suave">Antes hay que saber <b>${lista.length} ${lista.length === 1 ? 'tema' : 'temas'}</b>. Los que necesita directo están marcados con ★.</p>
           <p class="mapa-chips">${lista.map((s) => (t.n.includes(s) ? link(s).replace('">', '">★ ') : link(s))).join('')}</p>`}`;
    info.hidden = false;
  }

  // ------------------------------------------------------------------
  // Vista: mover y acercar (como los gráficos).
  // ------------------------------------------------------------------
  let vx = 0, vy = 0, k = 1;
  const KMIN = 0.2, KMAX = 2.5;
  const esCelular = () => marco.clientWidth < 700;

  function aplicar() {
    mundo.setAttribute('transform', `translate(${vx.toFixed(1)} ${vy.toFixed(1)}) scale(${k.toFixed(4)})`);
  }
  function vistaInicial() {
    const w = marco.clientWidth;
    // en la compu entra todo a lo ancho; en el celular, letra que se pueda leer
    k = esCelular() ? 0.78 : Math.min(1, w / ANCHO);
    vx = esCelular() ? 0 : Math.max(0, (w - ANCHO * k) / 2);
    vy = 0;
    // la altura del marco: lo que ocupa el mapa (en el celular, casi toda la pantalla)
    marco.style.height = esCelular() ? '' : `${Math.ceil(ALTO * k) + 8}px`;
    aplicar();
  }
  function zoom(f: number, px = marco.clientWidth / 2, py = marco.clientHeight / 2) {
    const nk = Math.min(KMAX, Math.max(KMIN, k * f));
    vx = px - ((px - vx) * nk) / k;
    vy = py - ((py - vy) * nk) / k;
    k = nk;
    aplicar();
  }
  function mostrarAviso(texto: string) {
    aviso.textContent = texto;
    aviso.classList.add('visible');
    clearTimeout((mostrarAviso as any).t);
    (mostrarAviso as any).t = setTimeout(() => aviso.classList.remove('visible'), 1800);
  }
  const local = (cx: number, cy: number) => {
    const r = svg.getBoundingClientRect();
    return [cx - r.left, cy - r.top];
  };

  marco.querySelectorAll<HTMLButtonElement>('[data-zoom]').forEach((b) =>
    b.addEventListener('click', () => zoom(Number(b.dataset.zoom))));
  marco.querySelector('[data-inicio]')!.addEventListener('click', vistaInicial);

  // Mouse: arrastrar mueve el mapa; Ctrl + rueda acerca.
  let arrastre: { x: number; y: number; movio: boolean } | null = null;
  let recienArrastrado = false;
  svg.addEventListener('pointerdown', (e) => {
    if (e.pointerType !== 'mouse' || e.button !== 0) return;
    arrastre = { x: e.clientX, y: e.clientY, movio: false };
  });
  window.addEventListener('pointermove', (e) => {
    if (!arrastre || e.pointerType !== 'mouse') return;
    const dx = e.clientX - arrastre.x, dy = e.clientY - arrastre.y;
    if (!arrastre.movio && Math.hypot(dx, dy) < 5) return;
    arrastre.movio = true;
    svg.classList.add('arrastrando');
    vx += dx; vy += dy;
    arrastre.x = e.clientX; arrastre.y = e.clientY;
    aplicar();
  });
  window.addEventListener('pointerup', () => {
    if (arrastre?.movio) { recienArrastrado = true; setTimeout(() => (recienArrastrado = false), 0); }
    arrastre = null;
    svg.classList.remove('arrastrando');
  });
  svg.addEventListener('wheel', (e) => {
    if (!e.ctrlKey) {
      if (!(svg as any)._avisado) { (svg as any)._avisado = true; mostrarAviso('Para acercar: Ctrl + rueda, o los botones + y −'); }
      return;
    }
    e.preventDefault();
    const [px, py] = local(e.clientX, e.clientY);
    zoom(Math.exp(-e.deltaY * 0.01), px, py);
  }, { passive: false });

  // Dedos: uno mueve la página; dos mueven y acercan el mapa.
  let dos: { d: number; k: number; mx: number; my: number; vx: number; vy: number } | null = null;
  let unDedo: { x: number; y: number; avisado: boolean } | null = null;
  const medidaDos = (t: TouchList) => {
    const [x1, y1] = local(t[0].clientX, t[0].clientY);
    const [x2, y2] = local(t[1].clientX, t[1].clientY);
    return { d: Math.max(1, Math.hypot(x2 - x1, y2 - y1)), x: (x1 + x2) / 2, y: (y1 + y2) / 2 };
  };
  svg.addEventListener('touchstart', (e) => {
    if (e.touches.length === 2) {
      e.preventDefault();
      const m = medidaDos(e.touches);
      dos = { d: m.d, k, mx: m.x, my: m.y, vx, vy };
      unDedo = null;
    } else if (e.touches.length === 1) {
      unDedo = { x: e.touches[0].clientX, y: e.touches[0].clientY, avisado: false };
    }
  }, { passive: false });
  svg.addEventListener('touchmove', (e) => {
    if (dos && e.touches.length >= 2) {
      e.preventDefault();
      const m = medidaDos(e.touches);
      const nk = Math.min(KMAX, Math.max(KMIN, dos.k * (m.d / dos.d)));
      // el punto del mapa que estaba entre los dedos sigue entre los dedos
      vx = m.x - ((dos.mx - dos.vx) * nk) / dos.k;
      vy = m.y - ((dos.my - dos.vy) * nk) / dos.k;
      k = nk;
      aplicar();
    } else if (unDedo && !unDedo.avisado) {
      const dx = e.touches[0].clientX - unDedo.x, dy = e.touches[0].clientY - unDedo.y;
      if (Math.abs(dx) > 25 && Math.abs(dx) > Math.abs(dy) * 1.5) {
        unDedo.avisado = true;
        mostrarAviso('Usá dos dedos para mover el mapa');
      }
    }
  }, { passive: false });
  svg.addEventListener('touchend', (e) => { if (e.touches.length < 2) dos = null; if (e.touches.length === 0) unDedo = null; });

  // ------------------------------------------------------------------
  // Toques: el primer toque marca el camino; el segundo abre el tema.
  // ------------------------------------------------------------------
  nodos.forEach((n) => {
    n.addEventListener('click', (e) => {
      if (recienArrastrado) { e.preventDefault(); return; }
      const s = n.dataset.slug!;
      // Ctrl/Cmd + clic: abre en otra pestaña como cualquier link
      if (e.ctrlKey || e.metaKey || e.shiftKey) return;
      if (elegido === s) return; // segundo toque: se abre el tema
      e.preventDefault();
      elegir(s);
    });
  });
  svg.addEventListener('click', (e) => {
    if (recienArrastrado) return;
    if (!(e.target as Element).closest('.mapa-nodo')) elegir(null);
  });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') elegir(null); });

  vistaInicial();
  let anchoAnterior = marco.clientWidth;
  new ResizeObserver(() => {
    if (marco.clientWidth !== anchoAnterior) { anchoAnterior = marco.clientWidth; vistaInicial(); }
  }).observe(marco);
</script>
