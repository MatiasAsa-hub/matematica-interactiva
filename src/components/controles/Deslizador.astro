---
// Un deslizador con su nombre, el valor actual y botones − y + para ajustar fino.
// La lógica está en src/lib/grafico/controles.js (conectarDeslizador).
interface Props {
  param: string;       // nombre interno (ej. "a")
  etiqueta?: string;   // lo que se ve (por defecto, el nombre)
  min: number;
  max: number;
  paso: number;        // paso del deslizador
  pasoBoton?: number;  // cuánto suman los botones − y +
  valor: number;       // valor inicial
  ayuda?: string;      // texto chiquito al lado del nombre (ej. "donde arrancás")
}
const { param, etiqueta = param, min, max, paso, pasoBoton = paso, valor, ayuda } = Astro.props;
const id = `desl-${param}-${Math.random().toString(36).slice(2, 7)}`;
---
<div class="deslizador" data-param={param}>
  <label for={id} class="deslizador-nombre"><i>{etiqueta}</i> = <output for={id}>{valor}</output>{ayuda && <span class="deslizador-ayuda">{ayuda}</span>}</label>
  <div class="deslizador-fila">
    <button type="button" class="deslizador-paso" data-delta={-pasoBoton} aria-label={`Restar ${pasoBoton} a ${etiqueta}`}>−</button>
    <input id={id} type="range" min={min} max={max} step={paso} value={valor} />
    <button type="button" class="deslizador-paso" data-delta={pasoBoton} aria-label={`Sumar ${pasoBoton} a ${etiqueta}`}>+</button>
  </div>
</div>
