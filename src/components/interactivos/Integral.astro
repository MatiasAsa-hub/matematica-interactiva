---
// Interactivo 7.a: la integral como suma de tiras, achicando dx.
// También sirve para la regla de Barrow (barrow: true) y para el área
// entre dos curvas (ejemplos con "abajo:").
// Lógica: src/interactivos/integral.js
// Los ejemplos vienen del tema (campo "integrales:" del .md), por ejemplo
//   "x^2 ; de 0 a 3"   o   "x + 2 ; abajo: x^2 ; de -1 a 2"
import Casillas from '../controles/Casillas.astro';
import { leerIntegral } from '../../lib/integrales.js';

interface Props { integrales?: string[]; barrow?: boolean }
const { integrales = ['x^2 ; de 0 a 3', '2x + 1 ; de 0 a 2', 'x^2 - 1 ; de 0 a 3'], barrow = false } = Astro.props;
// Se prueban al armar el sitio: si uno está mal escrito, el armado avisa.
for (const t of integrales) {
  if (leerIntegral(String(t)).b === null) throw new Error(`Falta "de ... a ..." en el ejemplo "${t}"`);
}

const casillas = [{ nombre: 'puntos', texto: 'Dónde se toma la altura', color: '--c-funcion', prendida: true }];
if (barrow) casillas.push({ nombre: 'barrow', texto: 'Regla de Barrow', color: '--c-integral', prendida: true });
---
<div class="interactivo" data-interactivo="integral" data-integrales={JSON.stringify(integrales.map(String))}>
  <div class="interactivo-grafico">
    <div class="cuentas-cabecera" hidden={integrales.length < 2}>
      <button type="button" class="plano-boton" data-anterior aria-label="Ejemplo anterior">‹</button>
      <span data-contador></span>
      <button type="button" class="plano-boton" data-proxima aria-label="Ejemplo siguiente">›</button>
    </div>
    <div class="expresion" data-expresion aria-live="polite"></div>
    <p class="lectura-log lectura-integral" data-lectura aria-live="polite"></p>
    <div class="grafico" data-grafico></div>
    <div class="interactivo-acciones">
      <button type="button" class="boton boton-chico" data-achicar>Achicar <i>dx</i></button>
    </div>
  </div>

  <div class="interactivo-controles">
    <div class="selector-forma selector-3" role="radiogroup" aria-label="Altura de cada tira">
      <button type="button" role="radio" aria-checked="true" data-altura="izq">Izquierda<span>borde izquierdo</span></button>
      <button type="button" role="radio" aria-checked="false" data-altura="medio">Medio<span>mitad de la tira</span></button>
      <button type="button" role="radio" aria-checked="false" data-altura="der">Derecha<span>borde derecho</span></button>
    </div>

    <div class="tabla-caja tabla-h" data-tabla></div>

    <Casillas titulo="Mostrar" casillas={casillas} />

    <div class="info" data-info aria-live="polite"></div>
  </div>
</div>

<script>
  import { iniciarIntegral } from '../../interactivos/integral.js';
  document.querySelectorAll<HTMLElement>('[data-interactivo="integral"]').forEach(iniciarIntegral);
</script>
