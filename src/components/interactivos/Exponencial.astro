---
// Interactivo de la función exponencial f(x) = a · kˣ.
// Lógica: src/interactivos/exponencial.js
import Deslizador from '../controles/Deslizador.astro';
import Casillas from '../controles/Casillas.astro';
---
<div class="interactivo" data-interactivo="exponencial">
  <div class="interactivo-grafico">
    <div class="expresion" data-expresion aria-live="polite"></div>
    <div class="grafico" data-grafico></div>
    <div class="tabla-caja" data-tabla hidden></div>
    <div class="interactivo-acciones">
      <button type="button" class="boton boton-chico" data-repetir>
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
        Repetir animación
      </button>
    </div>
  </div>

  <div class="interactivo-controles">
    <Deslizador param="k" min={0.2} max={5} paso={0.1} pasoBoton={0.5} valor={2} ayuda="la base: por cuánto se multiplica" />
    <Deslizador param="a" min={-4} max={4} paso={0.5} valor={1} ayuda="donde arranca: f(0)" />
    <p class="cartel-aviso" data-aviso hidden></p>

    <Casillas
      titulo="Mostrar en el gráfico"
      casillas={[
        { nombre: 'saltos', texto: 'Saltos ×<i>k</i>', color: '--c-vertice', prendida: true },
        { nombre: 'ordenada', texto: 'Ordenada al origen', color: '--c-ordenada', prendida: true },
        { nombre: 'lineal', texto: 'Comparar con una lineal', color: '--c-fantasma' },
        { nombre: 'asintotas', texto: 'Asíntota', color: '--texto' },
        { nombre: 'crece', texto: 'Crece o decrece', color: '--c-crece' },
        { nombre: 'dominio', texto: 'Dominio e imagen', color: '--c-funcion' },
      ]}
      extras={[
        { nombre: 'animacion', texto: 'Animación de puntos', color: '--c-funcion', prendida: true },
        { nombre: 'tabla', texto: 'Tabla <i>x</i> | <i>f</i>(<i>x</i>)', color: '--c-funcion' },
      ]}
    />

    <div class="info" data-info aria-live="polite"></div>
  </div>
</div>

<script>
  import { iniciarExponencial } from '../../interactivos/exponencial.js';
  document.querySelectorAll<HTMLElement>('[data-interactivo="exponencial"]').forEach(iniciarExponencial);
</script>
