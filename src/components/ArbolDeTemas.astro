---
// Lista de temas: las unidades agrupadas por etapa. Cada unidad tiene su
// ícono y se abre con un toque: adentro, sus temas en una grilla de tarjetas.
// En la compu arrancan todas abiertas; en el celular, cerradas (para que la
// lista sea corta). Se usa en la página de Temas (alumnos) y en la de Tutores.
import IconoUnidad from './IconoUnidad.astro';
import BotonGuia from './BotonGuia.astro';
import { datosDelSitio, listaDeUnidades, obtenerTema } from '../lib/contenido.js';
import { tieneGuia } from '../lib/guia.js';
import { url } from '../lib/rutas.js';

interface Props {
  destino: 'temas' | 'tutores';            // a qué página llevan los links
  filtro?: (tema: any) => boolean;        // qué temas se muestran
}
const { destino, filtro = () => true } = Astro.props;
const sitio = datosDelSitio();
const unidades = listaDeUnidades()
  .map((u) => ({ ...u, temas: u.temas.filter(filtro) }))
  .filter((u) => u.temas.length > 0);

// Dentro de una unidad larga, los temas se separan con subtítulos
// (el campo "subseccion" de cada tema). En las cortas no hace falta.
function grupos(u: any) {
  if (u.temas.length <= 6) return [['', u.temas]];
  const mapa = new Map<string, any[]>();
  for (const t of u.temas) {
    const clave = t.subseccion || '';
    if (!mapa.has(clave)) mapa.set(clave, []);
    mapa.get(clave)!.push(t);
  }
  return [...mapa.entries()];
}
---
<div class="arbol-temas" data-arbol>
  {sitio.etapas.map((etapa: any) => {
    const deEsta = unidades.filter((u) => u.etapa === etapa.id);
    if (deEsta.length === 0) return null;
    return (
      <section class="etapa">
        <h2 class="etapa-titulo">{etapa.nombre}</h2>
        <p class="etapa-descripcion">{etapa.descripcion}</p>
        {deEsta.map((u) => (
          <details class="unidad" id={u.id} name="unidad">
            <summary>
              <IconoUnidad id={u.id} />
              <span class="unidad-textos">
                <span class="unidad-nombre">{u.nombre}</span>
                <span class="unidad-descripcion">{u.descripcion}</span>
              </span>
              <span class="unidad-cuenta">{u.temas.length} temas</span>
            </summary>
            <div class="unidad-temas">
              {u.temas.some((t: any) => tieneGuia(obtenerTema(t.slug))) && (
                <p class="acciones-unidad"><BotonGuia ruta={`guia/unidad/${u.id}/`} texto="Imprimir la guía de la unidad" /></p>
              )}
              {grupos(u).map(([subtitulo, lista]: any) => (
                <>
                  {subtitulo && <p class="unidad-subtitulo">{subtitulo}</p>}
                  <ol class="lista-temas grilla-tarjetas">
                    {lista.map((t: any) => (
                      <li>
                        <a class="tarjeta-link" href={url(`${destino}/${t.slug}/`)}>
                          <span class="tarjeta-titulo">{t.titulo}</span>
                          <span class="tarjeta-texto">{t.resumen}</span>
                        </a>
                      </li>
                    ))}
                  </ol>
                </>
              ))}
            </div>
          </details>
        ))}
      </section>
    );
  })}
</div>

<script is:inline>
  // Va "en línea" para que corra antes de que se vea la página (sin saltos).
  (function () {
    var unidades = document.querySelectorAll('[data-arbol] details.unidad');
    // En la compu hay lugar: todas las unidades arrancan abiertas.
    if (window.matchMedia('(min-width: 900px)').matches) {
      unidades.forEach(function (u) { u.removeAttribute('name'); u.open = true; });
    }
    // Si la dirección termina en #unidad (por ejemplo, al tocar "volver" desde
    // un tema), esa unidad aparece abierta.
    function abrirLaDelLink() {
      var id = decodeURIComponent(location.hash.slice(1));
      var unidad = id && document.getElementById(id);
      if (unidad && unidad.tagName === 'DETAILS') {
        unidad.open = true;
        unidad.scrollIntoView({ block: 'start' });
      }
    }
    abrirLaDelLink();
    window.addEventListener('hashchange', abrirLaDelLink);
  })();
</script>
