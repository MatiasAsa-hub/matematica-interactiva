---
// El botón de "volver" que va arriba de cada página: lleva un nivel para atrás
// (por ejemplo, de un tema a su unidad en la lista de temas).
interface Props { href: string; texto: string }
const { href, texto } = Astro.props;
---
<a class="volver" href={href}>
  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
  <span>{texto}</span>
</a>
