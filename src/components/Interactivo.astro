---
// Elige qué interactivo mostrar según el nombre que figura en el tema
// (campo "interactivo:" al principio del archivo .md).
// Cuando haya un interactivo nuevo, se agrega acá.
// "opciones" son los demás datos del principio del .md (por ejemplo, "cuentas:").
import Cuadratica from './interactivos/Cuadratica.astro';
import RectaSignos from './interactivos/RectaSignos.astro';
import RectaMultiplicacion from './interactivos/RectaMultiplicacion.astro';
import OrdenOperaciones from './interactivos/OrdenOperaciones.astro';
import Galera from './interactivos/Galera.astro';
import Fraccion from './interactivos/Fraccion.astro';
import FraccionesOperaciones from './interactivos/FraccionesOperaciones.astro';
import Potencias from './interactivos/Potencias.astro';
import Distributiva from './interactivos/Distributiva.astro';
import McmMcd from './interactivos/McmMcd.astro';
import Terminos from './interactivos/Terminos.astro';
import Balanza from './interactivos/Balanza.astro';
import Intervalos from './interactivos/Intervalos.astro';
import Inecuacion from './interactivos/Inecuacion.astro';
import Lineal from './interactivos/Lineal.astro';
import Funcion from './interactivos/Funcion.astro';
import Polinomica from './interactivos/Polinomica.astro';
import Laboratorio from './interactivos/Laboratorio.astro';
import Exponencial from './interactivos/Exponencial.astro';
import Logaritmica from './interactivos/Logaritmica.astro';

interface Props { nombre: string; opciones?: Record<string, any> }
const { nombre, opciones = {} } = Astro.props;
const conocidos = ['cuadratica', 'recta-signos', 'recta-multiplicacion', 'orden-operaciones', 'galera', 'fraccion', 'fracciones-operaciones', 'potencias', 'distributiva', 'mcm-mcd', 'terminos', 'balanza', 'intervalos', 'inecuacion', 'lineal', 'funcion', 'polinomica', 'laboratorio', 'exponencial', 'logaritmica'];
---
{nombre === 'cuadratica' && <Cuadratica />}
{nombre === 'recta-signos' && <RectaSignos />}
{nombre === 'recta-multiplicacion' && <RectaMultiplicacion />}
{nombre === 'orden-operaciones' && <OrdenOperaciones cuentas={opciones.cuentas} />}
{nombre === 'galera' && <Galera divisiones={opciones.divisiones} />}
{nombre === 'fraccion' && <Fraccion />}
{nombre === 'fracciones-operaciones' && <FraccionesOperaciones />}
{nombre === 'potencias' && <Potencias />}
{nombre === 'distributiva' && <Distributiva />}
{nombre === 'mcm-mcd' && <McmMcd />}
{nombre === 'terminos' && <Terminos />}
{nombre === 'balanza' && <Balanza ecuaciones={opciones.ecuaciones} modo={opciones.modo} />}
{nombre === 'intervalos' && <Intervalos />}
{nombre === 'inecuacion' && <Inecuacion inecuaciones={opciones.inecuaciones} />}
{nombre === 'lineal' && <Lineal />}
{nombre === 'funcion' && <Funcion funciones={opciones.funciones} />}
{nombre === 'polinomica' && <Polinomica />}
{nombre === 'laboratorio' && <Laboratorio />}
{nombre === 'exponencial' && <Exponencial />}
{nombre === 'logaritmica' && <Logaritmica />}
{!conocidos.includes(nombre) && (
  <p class="cartel-aviso">Acá va el interactivo "{nombre}", que todavía no está hecho.</p>
)}
