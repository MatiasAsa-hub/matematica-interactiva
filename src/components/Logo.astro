---
// El logo: la ∀ ("para todo") con un punto amarillo en la punta, como los
// puntos de los gráficos. Se usa en el encabezado y en el inicio.
interface Props { medida?: number }
const { medida = 28 } = Astro.props;
---
<svg class="logo" viewBox="0 0 48 48" width={medida} height={medida} aria-hidden="true" fill="none" stroke-linecap="round" stroke-linejoin="round">
  <path d="M10 9 24 39 38 9M15.6 21H32.4" stroke="currentColor" stroke-width="4.6" />
  <circle cx="24" cy="39" r="4.6" fill="var(--marca-punto)" />
</svg>
